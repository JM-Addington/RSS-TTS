# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-demo-key-replace-in-production-1234567890abcdef
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# In Docker container, maps to:
# - Development: sqlite-data:/app/data (named volume)
# - Production: ./data/sqlite-data:/app/data (host directory)
SQLITE_DATA_DIR=data

# Celery Configuration
# For web service in Docker: CELERY_BROKER_URL=redis://worker:6379/0
# For worker service or local development: CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# OpenAI Settings
OPENAI_API_KEY=sk-demo-openai-key-replace-with-your-actual-key
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# RSS Feed Settings
PODCAST_IMAGE_URL=https://example.com/podcast-image.jpg

# Testing configurations
CELERY_TASK_ALWAYS_EAGER=False  # Set to True to run tasks synchronously without a worker
# TEST_SECRET_KEY=test-secret-key  # Separate key for testing environments

# Media and Static Files
# In Docker container, these map to:
# - MEDIA_ROOT=/app/media (host directory './media')
# - STATIC_ROOT=/app/staticfiles (host directory './staticfiles')
MEDIA_ROOT=media  # For file uploads
STATIC_ROOT=staticfiles  # For static files

# Additional settings
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,example.com  # Production hosts
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com  # For CSRF protection in production

# Production server settings (used in docker-compose.prod.yml)
# The production environment uses Gunicorn instead of the Django development server
# WEB_CONCURRENCY=4  # Number of Gunicorn workers
# GUNICORN_TIMEOUT=120  # Gunicorn timeout in seconds
